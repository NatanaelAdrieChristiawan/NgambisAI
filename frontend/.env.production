# Ngambis.ai Frontend Production Environment Variables
# Used during `vite build` for production deployment

# Backend API base URL - kosong karena Nginx akan proxy /api/ ke backend
# Dengan baseURL kosong, request jadi relative (misal /api/auth/login)
# dan Nginx config akan forward ke http://localhost:8080
VITE_API_BASE_URL=

# App name
VITE_APP_NAME=Ngambis.ai
